[Unit]
Description=Terrarium MQTT climate logic
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=krisp
Group=krisp
WorkingDirectory=/home/krisp/terrarium-project
ExecStart=/home/krisp/terrarium-project/.venv/bin/python -m raspberry.service
Restart=on-failure
RestartSec=5
Environment=TERRARIUM_MQTT_BROKER=192.168.24.166
Environment=TERRARIUM_MQTT_PORT=1883
Environment=TERRARIUM_LOG_LEVEL=INFO

[Install]
WantedBy=multi-user.target